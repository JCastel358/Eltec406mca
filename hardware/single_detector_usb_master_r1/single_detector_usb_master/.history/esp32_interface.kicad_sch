	(text "USB POWER DOMAIN\nUSB cable -> existing ESP32 USB-C receptacle -> module VIN pin.\nNo battery rail is connected to USB_PRESENT_5V or ESP_3V3."
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1cd53641-0c7d-57d6-a156-b51a83d8eb7b")
	)
	(text "Firmware mapping retained: SCLK18, MOSI23, MISO19, CS5, DRDY4.\nEmitter outputs: GPIO33, GPIO25, GPIO26. New GPIO35 input: LOW=power ready.\nSPI crosses to the switched ADC supply through powered-off-protected buffers.\nUse the separate R1 firmware to wait/retry initialization and reject supply-loss captures."
		(exclude_from_sim no)
		(at 25.4 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "249a6f2e-e014-589f-becc-2de19249ac53")
	)
	(text "Socket row separation: 25.40 mm. Pitch: 2.54 mm.\nOriginal duplicate pad28 is not reproduced.\nBoth module ground pins are explicitly connected to GND.\nOnly the plug-in module is omitted from PCBA; both sockets are populated."
		(exclude_from_sim no)
		(at 203.2 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e61f0435-a779-572d-8aaa-84889cda779c")
	)
