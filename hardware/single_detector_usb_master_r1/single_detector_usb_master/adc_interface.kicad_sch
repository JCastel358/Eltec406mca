	(text "AIN0/1: test/reference pair1; AIN2/3: pair2; AIN4/5: pair3.\nUnused AIN6 and AIN7 are tied to GND.\nThe legacy AIN7 battery divider is removed: firmware does not use it.\nAll eight analog grounds and digital ground are joined explicitly on the carrier."
		(exclude_from_sim no)
		(at 25.4 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2360dbba-dd9e-5931-90ea-3208781da63d")
	)
	(text "J6 physical numbering is interleaved by channel.\nThis is a socket footprint, not the module body.\nThe build validates each socket pad against the source module coordinates.\nNeither module nor barrel jacks will be included in JLC population."
		(exclude_from_sim no)
		(at 203.2 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "30c4a254-e454-5900-9c3b-7b16c8d9115f")
	)
	(text "ADC BATTERY DOMAIN - seller schematic, ASIN B0DBSWRQZS\nHeader5V ->10uH -> AVDD with22uF/1uF/100nF bypass; AVDD -> onboard3.3V regulator.\nEach analog input has100R series and100nF at the ADC.\nVerify installed module revision, filterDCR and actualAVDD before release."
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
