	(text "U51 spare channel: input tied LOW; OE tied HIGH; output NC.\nDCT pinout: 1OE=1, 1A=2, 1Y=6, 2OE=7, 2A=5, 2Y=3, GND=4, VCC=8.\nDo not substitute the quad SN74LVC125A: its cited data sheet does not specify Ioff."
		(exclude_from_sim no)
		(at 25.4 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "631e3e58-b677-5445-91d4-44997e3f249f")
	)
	(text "FORWARD: ADC-powered outputs. RETURN: ESP32-powered outputs.\nSPI_PERMIT must be LOW until both supplies are valid; power stage provides this.\nEach OE defaults HIGH through a pull-up to its own supply."
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cdaf911b-cf4a-5e04-b982-e0fee8bcaa81")
	)
